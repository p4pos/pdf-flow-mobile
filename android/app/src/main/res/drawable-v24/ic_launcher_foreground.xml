<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Document Card Drop Shadow -->
    <path
        android:fillColor="#33000000"
        android:pathData="M34,26 h36 a6,6 0 0 1 6,6 v50 a6,6 0 0 1 -6,6 h-36 a6,6 0 0 1 -6,-6 v-50 a6,6 0 0 1 6,-6 z" />

    <!-- Main Document Page (Crisp Pure White) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M33,24 h30 l12,12 v48 a6,6 0 0 1 -6,6 h-36 a6,6 0 0 1 -6,-6 v-54 a6,6 0 0 1 6,-6 z" />

    <!-- Folded Top-Right Corner -->
    <path
        android:fillColor="#CBD5E1"
        android:pathData="M63,24 v12 h12 z" />

    <!-- Document Content Lines -->
    <path
        android:fillColor="#94A3B8"
        android:pathData="M40,42 h24 v3 h-24 z M40,48 h28 v3 h-28 z M40,54 h20 v3 h-20 z" />

    <!-- Vibrant Red/Coral PDF Flow Accent Badge -->
    <path
        android:pathData="M30,62 h30 a4,4 0 0 1 4,4 v15 a4,4 0 0 1 -4,4 h-30 a4,4 0 0 1 -4,-4 v-15 a4,4 0 0 1 4,-4 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="26"
                android:startY="62"
                android:endX="64"
                android:endY="85">
                <item android:offset="0.0" android:color="#EF4444" />
                <item android:offset="1.0" android:color="#DC2626" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- "PDF" Letters in Badge -->
    <!-- P -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M33,67 h4 a3,3 0 0 1 0,6 h-4 v6 h-2 v-12 z M33,69 v2 h3 a1,1 0 0 0 0,-2 z" />
    <!-- D -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M41,67 h4 a5,5 0 0 1 5,6 a5,5 0 0 1 -5,6 h-4 v-12 z M43,69 v8 h2 a3,3 0 0 0 3,-4 a3,3 0 0 0 -3,-4 z" />
    <!-- F -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52,67 h6 v2 h-4 v3 h3 v2 h-3 v5 h-2 v-12 z" />

    <!-- Flow Dynamic Wave Ribbon -->
    <path
        android:pathData="M58,64 C64,58 72,67 79,61 C81,59 83,56 83,52"
        android:strokeWidth="3.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="58"
                android:startY="64"
                android:endX="83"
                android:endY="52">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#2563EB" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
